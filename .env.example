# Copy to .env.local and fill in. Never commit .env.local.
# Use a Delta Exchange India API key with only the "Read Data" permission,
# whitelisted to your IP. The journal never places orders.
DELTA_API_KEY=
DELTA_API_SECRET=
# DELTA_BASE_URL=https://api.india.delta.exchange


# Telegram bot (npm run bot, on the sync server). Create a bot with @BotFather and paste its token.
# Every user shares it: each links their own chat from Settings → Telegram.
# TELEGRAM_CHAT_ID is optional: a chat linked to OWNER_USER_ID on the bot's first start (the pre-accounts setup).
# TELEGRAM_BOT_USERNAME is the bot's @name for t.me links (web app too); defaults to Jornalling_bot.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_SYNC_SECONDS=60

# AI features (weekly review, note suggestions, voice notes) through Vercel AI Gateway.
# Create a key at https://vercel.com/ai-gateway (API keys). Trade data and notes are sent there.
# AI_GATEWAY_API_KEY=
# Optional model overrides (ids from https://ai-gateway.vercel.sh/v1/models). The defaults
# work on the free tier; with paid credits you can use e.g. anthropic/claude-sonnet-5.5.
# AI_REVIEW_MODEL=google/gemini-2.5-flash
# AI_FAST_MODEL=google/gemini-2.5-flash
# AI_TRANSCRIBE_MODEL=openai/gpt-4o-mini-transcribe

# Accounts (Clerk, installed from the Vercel Marketplace; vercel env pull fills these in).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Your own Edgebook user id (user_... from the Clerk dashboard). DELTA_API_KEY, npm run sync
# and the bot act for this account. Unset = the pre-accounts "legacy" owner (see npm run claim-legacy).
# OWNER_USER_ID=

# Cloud database (Turso). Leave unset to use the local file data/journal.db.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Phone push notifications. Generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Put the same three values on the hosted app (Vercel). The subject is the app's URL.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://your-app.vercel.app

# Locking users' Delta keys. Create both with: npm run keys:generate (writes them here).
# The PUBLIC key goes to Vercel too (it can only lock); the PRIVATE key goes only to the sync
# server (it unlocks). Never put the private key on Vercel. Losing it means every user reconnects.
# DELTA_KEYS_PUBLIC_KEY=
# DELTA_KEYS_PRIVATE_KEY=
# The sync server's addresses users whitelist on their key (defaults to the Lightsail server's IPs).
# SYNC_SERVER_IPS=15.206.227.0,2406:da1a:11d8:a300:8a23:358c:c477:aff

# The always-on server's own Delta key (whitelisted to the server's IPs). Kept on the PC only
# so it can be copied to the server's .env.local as its DELTA_API_KEY / DELTA_API_SECRET.
# DELTA_SERVER_API_KEY=
# DELTA_SERVER_API_SECRET=
